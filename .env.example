# Existing application configuration
MONGODB_URI=

# HubSpot account ID (also called Hub ID). Enables site-wide tracking.
HUBSPOT_PORTAL_ID=

# The same HubSpot form may be used for all three when it contains the union of
# the fields documented in docs/HUBSPOT.md.

# Create these forms in HubSpot and copy each form GUID here.
HUBSPOT_CONTACT_FORM_ID=
HUBSPOT_NEWSLETTER_FORM_ID=
HUBSPOT_WHATSAPP_FORM_ID=
